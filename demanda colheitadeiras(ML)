9. Fazer Previsões para Novas Cidades
# Exemplo: prever vendas para uma nova cidade
def prever_vendas_cidade(cidade, modelo_colheitadeira, tipo_colheitadeira, ano, mes):
    """
    Prever vendas para uma cidade específica
    """
    # Codificar inputs
    try:
        cidade_enc = le_cidade.transform([cidade])[0]
    except:
        # Se cidade não existe, usar média
        cidade_enc = vendas_por_cidade['cidade_encoded'].mean()
    
    try:
        modelo_enc = le_modelo.transform([modelo_colheitadeira])[0]
    except:
        modelo_enc = vendas_por_cidade['modelo_encoded'].mean()
    
    try:
        tipo_enc = le_tipo.transform([tipo_colheitadeira])[0]
    except:
        tipo_enc = vendas_por_cidade['tipo_encoded'].mean()
    
    # Criar array de features
    X_novo = np.array([[cidade_enc, modelo_enc, tipo_enc, ano, mes]])
    
    # Prever
    previsao = melhor_modelo.predict(X_novo)[0]
    
    return max(0, round(previsao))  # Garantir que não seja negativo

# Exemplo de uso
print("\n" + "="*60)
print("EXEMPLO DE PREVISÃO")
print("="*60)

# Pegar uma cidade do dataset
cidade_exemplo = vendas_por_cidade['cidade'].iloc[0]
modelo_exemplo = vendas_por_cidade['modelo_principal'].iloc[0]
tipo_exemplo = vendas_por_cidade['tipo_principal'].iloc[0]

previsao = prever_vendas_cidade(
    cidade=cidade_exemplo,
    modelo_colheitadeira=modelo_exemplo,
    tipo_colheitadeira=tipo_exemplo,
    ano=2024,
    mes=10
)

print(f"\nCidade: {cidade_exemplo}")
print(f"Modelo: {modelo_exemplo}")
print(f"Tipo: {tipo_exemplo}")
print(f"Período: Outubro/2024")
print(f"\n📊 Previsão de vendas: {previsao} unidades")
